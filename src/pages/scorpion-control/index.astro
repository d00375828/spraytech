---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTA from '../../components/CTA.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import { serviceAreas } from '../../data/serviceAreas';
import { site } from '../../data/site';

const title = 'Scorpion Control in St. George, UT | Spraytech';
const description =
	'Local scorpion control in St. George, Utah from Spraytech Pest and Weed Control. One-time and recurring service for Southern Utah homeowners.';

const commonPlaces = [
	'Around exterior walls',
	'Garages',
	'Rock landscaping',
	'Block walls',
	'Cracks and sheltered areas',
] as const;

const steps = [
	{
		number: '1',
		title: 'Understand the Problem',
		copy: "We look at what you're seeing and where scorpion activity is showing up around the property.",
	},
	{
		number: '2',
		title: 'Recommend the Right Service',
		copy: "We'll recommend treatment based on the situation instead of automatically pushing every customer into the same plan.",
	},
	{
		number: '3',
		title: 'Keep the Problem Under Control',
		copy: 'Choose one-time or recurring service depending on what makes sense for your property.',
	},
] as const;

const signs = [
	"You've found scorpions inside the home",
	"You're seeing repeated activity around the property",
	'Scorpions are appearing in garages or entry areas',
	'You want help reducing activity around the home',
] as const;

const benefits = [
	{
		title: 'Local Knowledge',
		copy: 'Spraytech is based in Southern Utah and understands the conditions local homeowners deal with.',
	},
	{
		title: 'Fast, Personal Service',
		copy: 'Communication stays simple and local.',
	},
	{
		title: 'Straightforward Recommendations',
		copy: "We'll recommend the service that makes sense for your property without pressuring you into treatments you don't need.",
	},
] as const;

const faqs = [
	{
		question: 'Are scorpions common in Southern Utah?',
		answer:
			"Scorpions are a familiar pest in Southern Utah's desert environment. Activity can vary by property, landscaping, weather, and available hiding places.",
	},
	{
		question: 'Do you offer one-time scorpion treatment?',
		answer:
			"Yes. Spraytech offers both one-time and recurring service depending on what makes sense for your property and the level of activity you're dealing with.",
	},
	{
		question: 'Do I have to sign up for recurring service?',
		answer:
			"No. We'll recommend the option that fits your situation without pressuring you into ongoing service you don't want.",
	},
	{
		question: 'What areas do you provide scorpion control in?',
		answer:
			'Spraytech is based in St. George and serves nearby communities including Washington, Santa Clara, Ivins, and Hurricane.',
	},
	{
		question: 'Are you licensed and insured?',
		answer: 'Yes. Spraytech Pest and Weed Control is licensed and insured.',
	},
	{
		question: 'How do I get a quote?',
		answer: `Call or text ${site.phone.display}. Online quote requests will also be available through the website.`,
	},
] as const;
---

<BaseLayout {title} {description}>
	<main id="main-content">
		<ServiceHero
			eyebrow="Scorpion Control • St. George, Utah"
			heading="Scorpion Control in St. George, Utah"
			copy="Scorpions are part of living in Southern Utah, but they don't have to take over your property. Spraytech provides local scorpion-control service designed around the conditions St. George homeowners deal with."
			icon="scorpion-control"
			visualLabel="Scorpion control service image placeholder"
			headingId="scorpion-hero-heading"
		/>

		<section class="page-section local-section" aria-labelledby="local-heading">
			<div class="container local-grid">
				<div>
					<SectionHeading
						eyebrow="A Southern Utah Problem"
						heading="Why Scorpions Show Up Around St. George Homes."
						id="local-heading"
					/>
					<div class="body-copy">
						<p>
							Southern Utah's desert environment and warm temperatures can make the area a natural
							fit for scorpions. Around residential properties, landscaping, sheltered spaces, and
							available insects may give them places to hide and reasons to stay nearby.
						</p>
						<p>
							Activity can differ from one home to another. Scorpions often seek protected areas,
							which is why homeowners may notice them around structures and landscaping.
						</p>
						<a class="text-link" href="/services/">Explore all pest and weed control services <span aria-hidden="true">→</span></a>
					</div>
				</div>

				<aside class="places-card" aria-labelledby="places-heading">
					<h3 id="places-heading">Places scorpions may show up</h3>
					<ul>
						{commonPlaces.map((place) => <li><span aria-hidden="true">✓</span>{place}</li>)}
					</ul>
				</aside>
			</div>
		</section>

		<section class="page-section approach-section" aria-labelledby="approach-heading">
			<div class="container">
				<SectionHeading heading="Getting a Scorpion Problem Under Control." id="approach-heading" />
				<ol class="steps-grid">
					{
						steps.map((step) => (
							<li>
								<span class="step-number" aria-hidden="true">{step.number}</span>
								<h3>{step.title}</h3>
								<p>{step.copy}</p>
							</li>
						))
					}
				</ol>
			</div>
		</section>

		<section class="page-section signs-section" aria-labelledby="signs-heading">
			<div class="container signs-grid">
				<SectionHeading heading="When It's Time to Call for Scorpion Control." id="signs-heading" />
				<ul class="signs-list">
					{signs.map((sign) => <li><span aria-hidden="true">→</span>{sign}</li>)}
				</ul>
			</div>
		</section>

		<section class="page-section benefits-section" aria-labelledby="benefits-heading">
			<div class="container">
				<SectionHeading
					heading="Local Scorpion Control Without the Runaround."
					id="benefits-heading"
				/>
				<div class="benefits-grid">
					{
						benefits.map((benefit, index) => (
							<article>
								<span class="benefit-number" aria-hidden="true">0{index + 1}</span>
								<h3>{benefit.title}</h3>
								<p>{benefit.copy}</p>
							</article>
						))
					}
				</div>
				<p class="credential"><span aria-hidden="true">✓</span> Licensed &amp; Insured</p>
			</div>
		</section>

		<section class="page-section areas-section" aria-labelledby="areas-heading">
			<div class="container">
				<SectionHeading
					heading="Scorpion Control Across the St. George Area."
					supportingText="Spraytech is based in St. George and serves surrounding Southern Utah communities."
					id="areas-heading"
				/>
				<ul class="areas-grid">
					{
						serviceAreas.map((area) => (
							<li><span class="area-name"><span aria-hidden="true">⌖</span>{area.name}</span></li>
						))
					}
				</ul>
			</div>
		</section>

		<section class="page-section faq-section" aria-labelledby="faq-heading">
			<div class="container faq-grid">
				<SectionHeading heading="Scorpion Control Questions" id="faq-heading" />
				<div class="faq-list">
					{
						faqs.map((faq) => (
							<details>
								<summary>{faq.question}</summary>
								<div class="faq-answer"><p>{faq.answer}</p></div>
							</details>
						))
					}
				</div>
			</div>
		</section>

		<CTA
			headline="Seeing Scorpions Around Your Home?"
			copy="Tell Spraytech what you're dealing with and we'll help you figure out the right next step."
			quoteLabel="Get a Free Quote"
			phoneLabel={`Call or Text ${site.phone.display}`}
			headingId="scorpion-cta-heading"
		/>
	</main>
</BaseLayout>

<style>
	.page-section {
		padding-block: var(--section-padding-block);
	}

	.local-section,
	.signs-section,
	.areas-section {
		background: var(--color-surface);
	}

	.local-grid,
	.signs-grid,
	.faq-grid {
		display: grid;
		gap: var(--space-7);
	}

	.local-section :global(.section-heading),
	.signs-section :global(.section-heading),
	.faq-section :global(.section-heading) {
		margin-bottom: 0;
	}

	.body-copy {
		max-width: 44rem;
		color: var(--color-text-muted);
	}

	.text-link {
		display: inline-block;
		margin-top: var(--space-3);
		font-weight: 800;
	}

	.places-card {
		padding: var(--space-6);
		border: var(--border);
		border-top: 3px solid var(--color-accent);
		background: var(--color-background);
		box-shadow: var(--shadow-sm);
	}

	.places-card h3 {
		font-size: 1.25rem;
	}

	.places-card ul,
	.signs-list,
	.areas-grid {
		margin: 0;
		list-style: none;
	}

	.places-card li {
		display: flex;
		gap: var(--space-3);
		padding-block: var(--space-2);
		border-bottom: var(--border);
	}

	.places-card li:last-child {
		border-bottom: 0;
	}

	.places-card li span,
	.credential span {
		color: var(--color-accent);
		font-weight: 800;
	}

	.steps-grid,
	.benefits-grid {
		display: grid;
		gap: var(--space-4);
		margin: 0;
		list-style: none;
	}

	.steps-grid li,
	.benefits-grid article {
		padding: var(--space-6);
		border: var(--border);
		background: var(--color-surface);
		box-shadow: var(--shadow-sm);
	}

	.step-number {
		display: grid;
		width: 2.5rem;
		height: 2.5rem;
		margin-bottom: var(--space-5);
		place-items: center;
		border-radius: 50%;
		background: var(--color-primary);
		color: var(--color-surface);
		font-weight: 800;
	}

	.steps-grid h3,
	.benefits-grid h3 {
		font-size: 1.25rem;
	}

	.steps-grid p,
	.benefits-grid p {
		margin: 0;
		color: var(--color-text-muted);
	}

	.signs-list {
		display: grid;
		gap: var(--space-3);
	}

	.signs-list li {
		display: flex;
		gap: var(--space-3);
		align-items: center;
		padding: var(--space-4) var(--space-5);
		border: var(--border);
		background: var(--color-background);
		font-weight: 700;
	}

	.signs-list span {
		color: var(--color-accent);
	}

	.benefits-section {
		background: var(--color-primary);
	}

	.benefits-section :global(.section-heading h2) {
		color: var(--color-surface);
	}

	.benefits-grid article {
		border-top: 3px solid var(--color-accent);
	}

	.benefit-number {
		display: block;
		margin-bottom: var(--space-5);
		color: var(--color-accent);
		font-size: 0.8rem;
		font-weight: 800;
		letter-spacing: 0.08em;
	}

	.credential {
		margin: var(--space-5) 0 0;
		color: var(--color-surface);
		font-weight: 800;
	}

	.areas-grid {
		display: grid;
		gap: var(--space-3);
	}

	.area-name {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		padding: var(--space-4);
		border: var(--border);
		border-radius: var(--radius-sm);
		background: var(--color-background);
		color: var(--color-primary);
		font-weight: 800;
	}

	.area-name > span {
		color: var(--color-accent);
	}

	.faq-list {
		border-top: var(--border);
	}

	details {
		border-bottom: var(--border);
	}

	summary {
		position: relative;
		padding: var(--space-5) var(--space-7) var(--space-5) 0;
		color: var(--color-primary);
		font-weight: 800;
		cursor: pointer;
		list-style: none;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	summary::after {
		position: absolute;
		top: 50%;
		right: var(--space-2);
		color: var(--color-accent);
		font-size: 1.5rem;
		font-weight: 400;
		content: '+';
		transform: translateY(-50%);
	}

	details[open] summary::after {
		content: '−';
	}

	.faq-answer {
		max-width: 46rem;
		padding: 0 var(--space-7) var(--space-5) 0;
		color: var(--color-text-muted);
	}

	.faq-answer p {
		margin: 0;
	}

	@media (min-width: 40rem) {
		.areas-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 48rem) {
		.steps-grid,
		.benefits-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.areas-grid {
			grid-template-columns: repeat(5, minmax(0, 1fr));
		}
	}

	@media (min-width: 64rem) {
		.local-grid {
			grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.6fr);
			gap: var(--space-9);
		}

		.signs-grid,
		.faq-grid {
			grid-template-columns: minmax(16rem, 0.65fr) minmax(0, 1fr);
			gap: var(--space-8);
		}
	}
</style>
