---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import CTA from '../../components/CTA.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { serviceAreas } from '../../data/serviceAreas';
import { site } from '../../data/site';

const title = 'About Spraytech Pest and Weed Control | St. George, UT';
const description =
	'Learn about Spraytech Pest and Weed Control, a locally owned and licensed pest and weed control company serving St. George and surrounding Southern Utah communities.';

const benefits = [
	{
		number: '01',
		title: 'Local Knowledge',
		copy: 'We live in Southern Utah and understand the pest, weed, and desert conditions homeowners here deal with.',
	},
	{
		number: '02',
		title: 'Personal Communication',
		copy: 'As a small local company, Spraytech keeps communication simple and responsive without sending customers through a giant call center.',
	},
	{
		number: '03',
		title: 'Recommendations That Make Sense',
		copy: "We'll recommend one-time or recurring service based on what your property needs without constantly pressuring you into unnecessary treatments.",
	},
] as const;

const trustItems = [
	'Locally Owned',
	'Licensed & Insured',
	'One-Time & Recurring Service',
	'Call, Text, or Email',
] as const;
---

<BaseLayout {title} {description}>
	<main id="main-content">
		<section class="about-hero" aria-labelledby="about-hero-heading">
			<div class="container about-hero-grid">
				<div>
					<p class="eyebrow">About Spraytech</p>
					<h1 id="about-hero-heading">Local Service From Someone Who Knows Southern Utah.</h1>
					<p class="lead">
						Spraytech Pest and Weed Control is a locally owned St. George company focused on
						straightforward pest and weed control, personal communication, and service based on
						what your property actually needs.
					</p>
					<div class="hero-actions">
						<Button href="/contact/">Get a Free Quote</Button>
						<Button
							href={site.phone.smsHref}
							variant="secondary"
							ariaLabel={`Call or text Spraytech at ${site.phone.display}`}
						>
							Call or Text {site.phone.display}
						</Button>
					</div>
				</div>

				<!-- Replace this placeholder with an optimized local owner or technician photo. -->
				<div class="owner-photo" role="img" aria-label="Owner or technician photo placeholder">
					<div class="photo-mark" aria-hidden="true">
						<span></span>
					</div>
					<p>{site.owner.name} / Owner Photo<br /><span>Local image coming soon</span></p>
				</div>
			</div>
		</section>

		<section class="page-section story-section" aria-labelledby="story-heading">
			<div class="container story-grid">
				<div class="story-copy">
					<SectionHeading
						eyebrow="Southern Utah Is Home"
						heading="We Deal With the Same Desert Conditions You Do."
						id="story-heading"
					/>
					<p>
						Spraytech is owned by someone who has lived in Southern Utah his whole life. That means
						local pests, persistent weeds, desert weather, and the conditions around St. George
						properties are familiar parts of living here—not problems viewed from a distant office.
					</p>
					<p>
						That local perspective helps keep service practical and communication personal. The goal
						is to understand what is happening at your property and recommend a sensible next step.
					</p>
					<div class="story-links">
						<a href="/services/">Explore our services <span aria-hidden="true">→</span></a>
						<a href="/contact/">Contact Spraytech <span aria-hidden="true">→</span></a>
					</div>
				</div>

				<aside class="story-placeholder" aria-labelledby="story-placeholder-heading">
					<p class="placeholder-label">Content placeholder</p>
					<h2 id="story-placeholder-heading">Owner Photo &amp; Personal Story</h2>
					<p>
						This space is ready for a real owner photo and additional personal background when those
						details are available.
					</p>
				</aside>
			</div>
		</section>

		<section class="page-section benefits-section" aria-labelledby="benefits-heading">
			<div class="container">
				<SectionHeading heading="Simple, Local, Straightforward." id="benefits-heading" />
				<div class="benefits-grid">
					{
						benefits.map((benefit) => (
							<article>
								<span class="benefit-number" aria-hidden="true">{benefit.number}</span>
								<h3>{benefit.title}</h3>
								<p>{benefit.copy}</p>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<section class="trust-section" aria-label="Spraytech business information">
			<div class="container trust-grid">
				{
					trustItems.map((item) => (
						<p><span aria-hidden="true">◆</span>{item}</p>
					))
				}
			</div>
		</section>

		<section class="statement-section" aria-label="Spraytech service philosophy">
			<div class="container">
				<blockquote>
					<p>“Pests and weeds are annoying enough. Your service company shouldn't be.”</p>
				</blockquote>
			</div>
		</section>

		<section class="page-section areas-section" aria-labelledby="areas-heading">
			<div class="container areas-layout">
				<div>
					<SectionHeading heading="Proudly Serving the St. George Area." id="areas-heading" />
					<a class="area-link" href="/service-areas/">View all service areas <span aria-hidden="true">→</span></a>
				</div>
				<ul class="areas-grid">
					{
						serviceAreas.map((area) => (
							<li><span aria-hidden="true">⌖</span>{area.name}</li>
						))
					}
				</ul>
			</div>
		</section>

		<CTA
			headline="Ready for Straightforward Local Service?"
			copy="Tell Spraytech what you're dealing with and we'll help you figure out the right next step."
			quoteLabel="Get a Free Quote"
			phoneLabel={`Call or Text ${site.phone.display}`}
			headingId="about-cta-heading"
		/>
	</main>
</BaseLayout>

<style>
	.about-hero {
		padding-block: clamp(var(--space-7), 7vw, var(--space-9));
	}

	.about-hero-grid,
	.story-grid,
	.areas-layout {
		display: grid;
		gap: var(--space-7);
		align-items: center;
	}

	.eyebrow,
	.placeholder-label {
		margin-bottom: var(--space-3);
		color: var(--color-accent);
		font-size: 0.8rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	h1 {
		max-width: 13ch;
		font-size: clamp(2.5rem, 8vw, 4.5rem);
	}

	.lead {
		max-width: 44rem;
		color: var(--color-text-muted);
		font-size: clamp(1.075rem, 2.2vw, 1.25rem);
	}

	.hero-actions {
		display: flex;
		align-items: stretch;
		flex-direction: column;
		gap: var(--space-3);
		margin-top: var(--space-6);
	}

	.owner-photo {
		position: relative;
		isolation: isolate;
		display: grid;
		overflow: hidden;
		min-height: 23rem;
		place-items: center;
		border: var(--border);
		border-radius: var(--radius-lg);
		background: var(--color-primary);
		box-shadow: var(--shadow-lg);
	}

	.owner-photo::after {
		position: absolute;
		z-index: -1;
		right: -15%;
		bottom: -35%;
		width: 85%;
		aspect-ratio: 1;
		border: 1px solid var(--color-border-on-primary);
		border-radius: 50%;
		content: '';
	}

	.photo-mark {
		position: relative;
		width: 7rem;
		height: 8rem;
		border: 2px solid var(--color-border-on-primary);
		border-radius: 3.5rem 3.5rem var(--radius-md) var(--radius-md);
	}

	.photo-mark span {
		position: absolute;
		top: 1.25rem;
		left: 50%;
		width: 3rem;
		height: 3rem;
		border: 2px solid var(--color-accent);
		border-radius: 50%;
		transform: translateX(-50%);
	}

	.owner-photo > p {
		position: absolute;
		bottom: var(--space-5);
		left: var(--space-5);
		margin: 0;
		color: var(--color-surface);
		font-weight: 800;
		line-height: 1.3;
		text-transform: uppercase;
	}

	.owner-photo > p span {
		font-size: 0.7rem;
		letter-spacing: 0.1em;
		opacity: 0.65;
	}

	.page-section {
		padding-block: var(--section-padding-block);
	}

	.story-section,
	.areas-section {
		background: var(--color-surface);
	}

	.story-copy :global(.section-heading),
	.areas-layout :global(.section-heading) {
		margin-bottom: var(--space-5);
	}

	.story-copy > p {
		max-width: 44rem;
		color: var(--color-text-muted);
	}

	.story-links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4) var(--space-5);
		margin-top: var(--space-5);
	}

	.story-links a,
	.area-link {
		font-weight: 800;
	}

	.story-placeholder {
		padding: var(--space-6);
		border: var(--border);
		border-top: 3px solid var(--color-accent);
		background: var(--color-background);
		box-shadow: var(--shadow-sm);
	}

	.story-placeholder h2 {
		font-size: 1.35rem;
	}

	.story-placeholder > p:last-child {
		margin: 0;
		color: var(--color-text-muted);
	}

	.benefits-grid {
		display: grid;
		gap: var(--space-4);
	}

	.benefits-grid article {
		padding: var(--space-6);
		border: var(--border);
		border-top: 3px solid var(--color-accent);
		background: var(--color-surface);
		box-shadow: var(--shadow-sm);
	}

	.benefit-number {
		display: block;
		margin-bottom: var(--space-5);
		color: var(--color-accent);
		font-size: 0.8rem;
		font-weight: 800;
		letter-spacing: 0.08em;
	}

	.benefits-grid h3 {
		font-size: 1.25rem;
	}

	.benefits-grid p {
		margin: 0;
		color: var(--color-text-muted);
	}

	.trust-section {
		padding-block: var(--space-4);
		background: var(--color-primary);
		color: var(--color-surface);
	}

	.trust-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-3) var(--space-4);
	}

	.trust-grid p {
		margin: 0;
		font-size: 0.8rem;
		font-weight: 700;
	}

	.trust-grid span {
		margin-right: var(--space-2);
		color: var(--color-accent);
		font-size: 0.65rem;
	}

	.statement-section {
		padding-block: var(--space-7);
	}

	blockquote {
		max-width: 58rem;
		margin: 0 auto;
		padding-left: var(--space-5);
		border-left: 4px solid var(--color-accent);
	}

	blockquote p {
		margin: 0;
		color: var(--color-primary);
		font-size: clamp(1.35rem, 4vw, 2rem);
		font-weight: 700;
		line-height: 1.35;
	}

	.areas-grid {
		display: grid;
		gap: var(--space-3);
		margin: 0;
		list-style: none;
	}

	.areas-grid li {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		padding: var(--space-4) var(--space-5);
		border: var(--border);
		border-radius: var(--radius-sm);
		background: var(--color-background);
		color: var(--color-primary);
		font-weight: 800;
	}

	.areas-grid span {
		color: var(--color-accent);
	}

	@media (min-width: 34rem) {
		.hero-actions {
			align-items: flex-start;
			flex-direction: row;
		}
	}

	@media (min-width: 48rem) {
		.benefits-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.trust-grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}

		.trust-grid p {
			text-align: center;
		}
	}

	@media (min-width: 64rem) {
		.about-hero-grid {
			grid-template-columns: minmax(0, 1.1fr) minmax(24rem, 0.7fr);
			gap: clamp(var(--space-7), 7vw, var(--space-9));
		}

		.owner-photo {
			min-height: 34rem;
		}

		.story-grid {
			grid-template-columns: minmax(0, 1.15fr) minmax(18rem, 0.55fr);
			gap: var(--space-9);
		}

		.areas-layout {
			grid-template-columns: minmax(16rem, 0.65fr) minmax(0, 1fr);
			gap: var(--space-8);
		}

		.areas-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
