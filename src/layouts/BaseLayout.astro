---
import '../styles/global.css';
import { site } from '../data/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	noindex?: boolean;
}

const {
	title = `${site.name} | ${site.primaryLocation.city}, ${site.primaryLocation.state}`,
	description = site.description,
	image,
	noindex = false,
} = Astro.props;

const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const socialImage = image && Astro.site ? new URL(image, Astro.site) : image;
---

<!doctype html>
<html lang="en-US">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#07090d" />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		{canonicalURL && <link rel="canonical" href={canonicalURL} />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="en_US" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonicalURL && <meta property="og:url" content={canonicalURL} />}
		{socialImage && <meta property="og:image" content={socialImage} />}
		<meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{socialImage && <meta name="twitter:image" content={socialImage} />}
		<title>{title}</title>
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to main content</a>
		<Header />
		<slot />
		<Footer />
	</body>
</html>

<style>
	.skip-link {
		position: fixed;
		top: var(--space-3);
		left: var(--space-3);
		z-index: 100;
		padding: var(--space-2) var(--space-4);
		border-radius: var(--radius-sm);
		background: var(--color-surface);
		box-shadow: var(--shadow-md);
		font-weight: 700;
		transform: translateY(calc(-100% - var(--space-5)));
	}

	.skip-link:focus {
		transform: translateY(0);
	}
</style>
