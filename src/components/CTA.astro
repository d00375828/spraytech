---
import Button from './Button.astro';
import { site } from '../data/site';

interface Props {
	headline?: string;
	copy?: string;
	quoteLabel?: string;
	phoneLabel?: string;
	showHours?: boolean;
	headingId?: string;
}

const {
	headline = 'Ready for a pest-free property?',
	copy = 'Tell us what you are seeing and we will help you choose the right next step.',
	quoteLabel = 'Get a Quote',
	phoneLabel = `Call or Text ${site.phone.display}`,
	showHours = false,
	headingId = 'cta-heading',
} = Astro.props;
---

<section class="cta" aria-labelledby={headingId}>
	<div class="container cta-inner">
		<div>
			<h2 id={headingId}>{headline}</h2>
			<p>{copy}</p>
		</div>
		<div class="cta-actions">
			<Button href="/contact/#quote">{quoteLabel}</Button>
			<Button
				href={site.phone.href}
				variant="secondary"
				ariaLabel={`Call or text Spraytech at ${site.phone.display}`}
			>
				{phoneLabel}
			</Button>
			{showHours && <p class="hours">{site.hours.days} <span aria-hidden="true">•</span> {site.hours.time}</p>}
		</div>
	</div>
</section>

<style>
	.cta {
		padding-block: var(--space-8);
		background: var(--color-primary);
	}

	.cta-inner {
		display: grid;
		gap: var(--space-6);
		align-items: center;
	}

	h2,
	p {
		color: var(--color-surface);
	}

	h2 {
		font-size: clamp(2rem, 6vw, 3.25rem);
	}

	p {
		max-width: 42rem;
		margin-bottom: 0;
		opacity: 0.82;
	}

	.cta-actions {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}

	.hours {
		margin: var(--space-1) 0 0;
		font-size: 0.875rem;
		font-weight: 700;
		text-align: center;
	}

	.cta-actions :global(.button--secondary) {
		border-color: var(--color-surface);
		color: var(--color-surface);
	}

	.cta-actions :global(.button--secondary:hover) {
		background: var(--color-surface);
		color: var(--color-primary);
	}

	@media (min-width: 48rem) {
		.cta-inner {
			grid-template-columns: minmax(0, 1fr) auto;
		}

		.cta-actions {
			align-items: stretch;
		}
	}
</style>
