---
import Button from './Button.astro';
import ServiceIcon from './ServiceIcon.astro';
import { site } from '../data/site';

interface Props {
	eyebrow: string;
	heading: string;
	copy: string;
	icon: string;
	visualLabel: string;
	headingId?: string;
}

const {
	eyebrow,
	heading,
	copy,
	icon,
	visualLabel,
	headingId = 'service-hero-heading',
} = Astro.props;
---

<section class="service-hero" aria-labelledby={headingId}>
	<div class="container service-hero-grid">
		<div class="service-hero-content">
			<p class="eyebrow">{eyebrow}</p>
			<h1 id={headingId}>{heading}</h1>
			<p class="lead">{copy}</p>
			<div class="hero-actions">
				<Button href="/contact/">Get a Free Quote</Button>
				<Button
					href={site.phone.smsHref}
					variant="secondary"
					ariaLabel={`Call or text Spraytech at ${site.phone.display}`}
				>
					Call or Text {site.phone.display}
				</Button>
			</div>
			<p class="trust-line">
				Licensed &amp; Insured <span aria-hidden="true">•</span> One-Time &amp; Recurring Service
			</p>
		</div>

		<div class="service-visual" role="img" aria-label={visualLabel}>
			<div class="visual-mark"><ServiceIcon name={icon} /></div>
			<div class="visual-lines" aria-hidden="true">
				<span></span><span></span><span></span>
			</div>
			<p><span>Need to put a pic here</span></p>
		</div>
	</div>
</section>

<style>
	.service-hero {
		padding-block: clamp(var(--space-7), 7vw, var(--space-9));
	}

	.service-hero-grid {
		display: grid;
		gap: var(--space-7);
		align-items: center;
	}

	.eyebrow {
		margin-bottom: var(--space-3);
		color: var(--color-accent);
		font-size: 0.8rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	h1 {
		max-width: 13ch;
		font-size: clamp(2.5rem, 8vw, 4.5rem);
	}

	.lead {
		max-width: 43rem;
		color: var(--color-text-muted);
		font-size: clamp(1.075rem, 2.2vw, 1.25rem);
	}

	.hero-actions {
		display: flex;
		align-items: stretch;
		flex-direction: column;
		gap: var(--space-3);
		margin-block: var(--space-6) var(--space-4);
	}

	.trust-line {
		margin: 0;
		color: var(--color-primary);
		font-size: 0.875rem;
		font-weight: 800;
	}

	.service-visual {
		position: relative;
		isolation: isolate;
		display: grid;
		overflow: hidden;
		min-height: 22rem;
		place-items: center;
		border: var(--border);
		border-radius: var(--radius-lg);
		background: var(--brand-black);
		box-shadow: var(--shadow-lg);
	}

	.service-visual::after {
		position: absolute;
		z-index: -1;
		right: -15%;
		bottom: -35%;
		width: 85%;
		aspect-ratio: 1;
		border: 1px solid var(--color-border-on-primary);
		border-radius: 50%;
		content: '';
	}

	.visual-mark {
		display: grid;
		width: 6rem;
		height: 6rem;
		place-items: center;
		border-radius: var(--radius-md);
		background: var(--color-background);
		box-shadow: var(--shadow-md);
		transform: scale(1.35);
	}

	.visual-lines {
		position: absolute;
		top: var(--space-5);
		right: var(--space-5);
		display: grid;
		gap: var(--space-2);
	}

	.visual-lines span {
		display: block;
		width: 3rem;
		height: 1px;
		background: var(--color-accent);
	}

	.service-visual > p {
		position: absolute;
		bottom: var(--space-5);
		left: var(--space-5);
		margin: 0;
		color: var(--color-on-primary);
		font-weight: 800;
		line-height: 1.3;
		text-transform: uppercase;
	}

	.service-visual > p span {
		font-size: 0.7rem;
		letter-spacing: 0.1em;
		opacity: 0.65;
	}

	@media (min-width: 34rem) {
		.hero-actions {
			align-items: flex-start;
			flex-direction: row;
		}
	}

	@media (min-width: 64rem) {
		.service-hero-grid {
			grid-template-columns: minmax(0, 1.1fr) minmax(24rem, 0.7fr);
			gap: clamp(var(--space-7), 7vw, var(--space-9));
		}

		.service-visual {
			min-height: 34rem;
		}
	}
</style>
