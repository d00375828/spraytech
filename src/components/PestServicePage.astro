---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from './CTA.astro';
import SectionHeading from './SectionHeading.astro';
import ServiceHero from './ServiceHero.astro';
import { serviceAreas } from '../data/serviceAreas';

interface Item {
	title: string;
	copy: string;
}

interface Faq {
	question: string;
	answer: string;
}

interface RelatedLink {
	label: string;
	href: string;
}

interface Props {
	title: string;
	description: string;
	slug: string;
	serviceName: string;
	heroEyebrow: string;
	heroHeading: string;
	heroCopy: string;
	localEyebrow: string;
	localHeading: string;
	localCopy: readonly string[];
	placesHeading: string;
	places: readonly string[];
	approachHeading: string;
	steps: readonly Item[];
	signsHeading: string;
	signs: readonly string[];
	benefitsHeading: string;
	benefits: readonly Item[];
	areasHeading: string;
	faqsHeading: string;
	faqs: readonly Faq[];
	ctaHeadline: string;
	ctaCopy: string;
	relatedLinks?: readonly RelatedLink[];
	relatedLinksLabel?: string;
	serviceOptionsHeading?: string;
	serviceOptionsCopy?: string;
}

const {
	title,
	description,
	slug,
	serviceName,
	heroEyebrow,
	heroHeading,
	heroCopy,
	localEyebrow,
	localHeading,
	localCopy,
	placesHeading,
	places,
	approachHeading,
	steps,
	signsHeading,
	signs,
	benefitsHeading,
	benefits,
	areasHeading,
	faqsHeading,
	faqs,
	ctaHeadline,
	ctaCopy,
	relatedLinks = [],
	relatedLinksLabel = 'Related services',
	serviceOptionsHeading,
	serviceOptionsCopy,
} = Astro.props;
---

<BaseLayout {title} {description}>
	<main id="main-content">
		<ServiceHero
			eyebrow={heroEyebrow}
			heading={heroHeading}
			copy={heroCopy}
			icon={slug}
			visualLabel={`${serviceName} service image placeholder`}
			headingId={`${slug}-hero-heading`}
		/>

		<section class="page-section local-section" aria-labelledby={`${slug}-local-heading`}>
			<div class="container local-grid">
				<div>
					<SectionHeading eyebrow={localEyebrow} heading={localHeading} id={`${slug}-local-heading`} />
					<div class="body-copy">
						{localCopy.map((paragraph) => <p>{paragraph}</p>)}
						<a class="text-link" href="/services/">Explore all pest and weed control services <span aria-hidden="true">→</span></a>
						{relatedLinks.length > 0 && (
							<p class="related-links">
								{relatedLinksLabel}:{' '}
								{relatedLinks.map((link, index) => (
									<><a href={link.href}>{link.label}</a>{index < relatedLinks.length - 1 ? ', ' : ''}</>
								))}
							</p>
						)}
					</div>
				</div>

				<aside class="places-card" aria-labelledby={`${slug}-places-heading`}>
					<h3 id={`${slug}-places-heading`}>{placesHeading}</h3>
					<ul>{places.map((place) => <li><span aria-hidden="true">✓</span>{place}</li>)}</ul>
				</aside>
			</div>
		</section>

		<section class="page-section approach-section" aria-labelledby={`${slug}-approach-heading`}>
			<div class="container">
				<SectionHeading heading={approachHeading} id={`${slug}-approach-heading`} />
				<ol class="steps-grid">
					{steps.map((step, index) => (
						<li><span class="step-number" aria-hidden="true">{index + 1}</span><h3>{step.title}</h3><p>{step.copy}</p></li>
					))}
				</ol>
			</div>
		</section>

		<section class="page-section signs-section" aria-labelledby={`${slug}-signs-heading`}>
			<div class="container signs-grid">
				<SectionHeading heading={signsHeading} id={`${slug}-signs-heading`} />
				<ul class="signs-list">{signs.map((sign) => <li><span aria-hidden="true">→</span>{sign}</li>)}</ul>
			</div>
		</section>

		{serviceOptionsHeading && serviceOptionsCopy && (
			<section class="page-section options-section" aria-labelledby={`${slug}-options-heading`}>
				<div class="container options-grid">
					<SectionHeading heading={serviceOptionsHeading} id={`${slug}-options-heading`} />
					<div class="options-copy">
						<p>{serviceOptionsCopy}</p>
						<div class="option-labels" aria-label="Available service options">
							<span>One-Time Service</span>
							<span>Recurring Service</span>
						</div>
					</div>
				</div>
			</section>
		)}

		<section class="page-section benefits-section" aria-labelledby={`${slug}-benefits-heading`}>
			<div class="container">
				<SectionHeading heading={benefitsHeading} id={`${slug}-benefits-heading`} />
				<div class="benefits-grid">
					{benefits.map((benefit, index) => (
						<article><span class="benefit-number" aria-hidden="true">0{index + 1}</span><h3>{benefit.title}</h3><p>{benefit.copy}</p></article>
					))}
				</div>
				<p class="credential"><span aria-hidden="true">✓</span> Licensed &amp; Insured</p>
			</div>
		</section>

		<section class="page-section areas-section" aria-labelledby={`${slug}-areas-heading`}>
			<div class="container">
				<SectionHeading heading={areasHeading} supportingText="Spraytech is based in St. George and serves surrounding Southern Utah communities." id={`${slug}-areas-heading`} />
				<ul class="areas-grid">{serviceAreas.map((area) => <li><span class="area-name"><span aria-hidden="true">⌖</span>{area.name}</span></li>)}</ul>
			</div>
		</section>

		<section class="page-section faq-section" aria-labelledby={`${slug}-faq-heading`}>
			<div class="container faq-grid">
				<SectionHeading heading={faqsHeading} id={`${slug}-faq-heading`} />
				<div class="faq-list">{faqs.map((faq) => <details><summary>{faq.question}</summary><div class="faq-answer"><p>{faq.answer}</p></div></details>)}</div>
			</div>
		</section>

		<CTA headline={ctaHeadline} copy={ctaCopy} quoteLabel="Get a Free Quote" headingId={`${slug}-cta-heading`} />
	</main>
</BaseLayout>

<style>
	.page-section { padding-block: var(--section-padding-block); }
	.local-section, .signs-section, .areas-section { background: var(--color-surface); }
	.local-grid, .signs-grid, .faq-grid { display: grid; gap: var(--space-7); }
	.local-section :global(.section-heading), .signs-section :global(.section-heading), .faq-section :global(.section-heading) { margin-bottom: 0; }
	.body-copy { max-width: 44rem; color: var(--color-text-muted); }
	.text-link { display: inline-block; margin-top: var(--space-3); font-weight: 800; }
	.related-links { margin-top: var(--space-4); font-size: 0.9375rem; }
	.related-links a { font-weight: 700; }
	.places-card { padding: var(--space-6); border: var(--border); border-top: 3px solid var(--color-accent); background: var(--color-background); box-shadow: var(--shadow-sm); }
	.places-card h3 { font-size: 1.25rem; }
	.places-card ul, .signs-list, .areas-grid { margin: 0; list-style: none; }
	.places-card li { display: flex; gap: var(--space-3); padding-block: var(--space-2); border-bottom: var(--border); }
	.places-card li:last-child { border-bottom: 0; }
	.places-card li span, .credential span { color: var(--color-accent); font-weight: 800; }
	.steps-grid, .benefits-grid { display: grid; gap: var(--space-4); margin: 0; list-style: none; }
	.steps-grid li, .benefits-grid article { padding: var(--space-6); border: var(--border); background: var(--color-surface); box-shadow: var(--shadow-sm); }
	.step-number { display: grid; width: 2.5rem; height: 2.5rem; margin-bottom: var(--space-5); place-items: center; border-radius: 50%; background: var(--brand-black); color: var(--color-on-primary); font-weight: 800; }
	.steps-grid h3, .benefits-grid h3 { font-size: 1.25rem; }
	.steps-grid p, .benefits-grid p { margin: 0; color: var(--color-text-muted); }
	.signs-list { display: grid; gap: var(--space-3); }
	.signs-list li { display: flex; gap: var(--space-3); align-items: center; padding: var(--space-4) var(--space-5); border: var(--border); background: var(--color-background); font-weight: 700; }
	.signs-list span { color: var(--color-accent); }
	.options-grid { display: grid; gap: var(--space-6); }
	.options-grid :global(.section-heading) { margin-bottom: 0; }
	.options-copy { max-width: 46rem; color: var(--color-text-muted); }
	.option-labels { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-5); }
	.option-labels span { padding: var(--space-3) var(--space-4); border: var(--border); border-left: 3px solid var(--color-accent); background: var(--color-surface); color: var(--color-primary); font-weight: 800; }
	.benefits-section { background: var(--brand-black); }
	.benefits-section :global(.section-heading h2) { color: var(--color-on-primary); }
	.benefits-grid article { border-top: 3px solid var(--color-accent); }
	.benefit-number { display: block; margin-bottom: var(--space-5); color: var(--color-accent); font-size: 0.8rem; font-weight: 800; letter-spacing: 0.08em; }
	.credential { margin: var(--space-5) 0 0; color: var(--color-on-primary); font-weight: 800; }
	.areas-grid { display: grid; gap: var(--space-3); }
	.area-name { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-4); border: var(--border); border-radius: var(--radius-sm); background: var(--color-background); color: var(--color-primary); font-weight: 800; }
	.area-name > span { color: var(--color-accent); }
	.faq-list { border-top: var(--border); }
	details { border-bottom: var(--border); }
	summary { position: relative; padding: var(--space-5) var(--space-7) var(--space-5) 0; color: var(--color-primary); font-weight: 800; cursor: pointer; list-style: none; }
	summary::-webkit-details-marker { display: none; }
	summary::after { position: absolute; top: 50%; right: var(--space-2); color: var(--color-accent); font-size: 1.5rem; font-weight: 400; content: '+'; transform: translateY(-50%); }
	details[open] summary::after { content: '−'; }
	.faq-answer { max-width: 46rem; padding: 0 var(--space-7) var(--space-5) 0; color: var(--color-text-muted); }
	.faq-answer p { margin: 0; }
	@media (min-width: 40rem) { .areas-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
	@media (min-width: 48rem) { .steps-grid, .benefits-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } .areas-grid { grid-template-columns: repeat(5, minmax(0, 1fr)); } }
	@media (min-width: 64rem) { .local-grid { grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.6fr); gap: var(--space-9); } .signs-grid, .faq-grid, .options-grid { grid-template-columns: minmax(16rem, 0.65fr) minmax(0, 1fr); gap: var(--space-8); } }
</style>
